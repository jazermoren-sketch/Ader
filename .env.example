# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Ader Dashboard - Discord OAuth2
DISCORD_CLIENT_ID=your_discord_application_client_id
DISCORD_CLIENT_SECRET=your_discord_application_client_secret
# Generate a long random value; never reuse the bot token as the session secret.
DASHBOARD_SESSION_SECRET=replace_with_a_long_random_secret
# Backend callback URL. This exact URL must be configured in Discord Developer Portal.
DASHBOARD_REDIRECT_URI=https://your-ader-backend.example.com/callback
# Public Cloudflare Pages frontend URL, for example https://ader-dashboard.pages.dev
DASHBOARD_FRONTEND_URL=https://your-ader-dashboard.pages.dev

# Hosting port (usually injected automatically by the panel)
# PORT=3000
# Optional explicit local bind host
# DASHBOARD_HOST=0.0.0.0

ENVIRONMENT=production
